<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- 性能测量必须用 Release，且禁止内联/预热裁剪造成的抖动 -->
    <Optimize>true</Optimize>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>Wisdom.Benchmarks</AssemblyName>
    <RootNamespace>Wisdom.Benchmarks</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wisdom.Office\Wisdom.Office.csproj" />
    <ProjectReference Include="..\..\src\Wisdom.Excel\Wisdom.Excel.csproj" />
    <ProjectReference Include="..\..\src\Wisdom.Word\Wisdom.Word.csproj" />
    <ProjectReference Include="..\..\src\Wisdom.Pdf\Wisdom.Pdf.csproj" />
    <ProjectReference Include="..\..\src\Wisdom.Office.Core\Wisdom.Office.Core.csproj" />
  </ItemGroup>

</Project>
